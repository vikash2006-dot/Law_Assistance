# Designs Law Assistant - Environment Configuration Example
# Copy this file to .env and insert your real Google Gemini API Key

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Embedding Provider: 'gemini' (requires valid Google AI Studio key) or 'local' (offline Chroma ONNX)
EMBEDDING_PROVIDER=gemini

# ChromaDB Vector Storage Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=designs_manual_collection

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://127.0.0.1:3000","http://localhost:5500","http://127.0.0.1:5500"]
